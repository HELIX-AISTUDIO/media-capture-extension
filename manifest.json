{
  "manifest_version": 3,
  "name": "网页媒体抓取器 (Media Catch)",
  "version": "0.2.5",
  "description": "抓取当前网页中的视频/图片/音频资源(m3u8/mp4/webm/mpd/jpg/png/gif 等),支持 m3u8/DASH 解析、预览、筛选、批量复制与下载。参考猫抓 cat-catch 架构重新工程化实现。",

  "minimum_chrome_version": "104",

  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "alarms",
    "webNavigation",
    "declarativeNetRequest"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "js/background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "网页媒体抓取器",
    "default_icon": {
      "16": "img/icon16.png",
      "48": "img/icon48.png",
      "128": "img/icon128.png"
    }
  },

  "icons": {
    "16": "img/icon16.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
