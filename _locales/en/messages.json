  "options_title": {
    "message": "Media Catch · Rule settings",
    "description": "Options title"
  },
  "options_h1": {
    "message": "Media Catch · Rule settings",
    "description": "Options h1"
  },
  "options_header_hint": {
    "message": "Rules are saved in the browser's <b>synced storage</b> (storage.sync) and take effect immediately after saving — no need to reload the extension.<br><span class=\"safe\">Safety promise: leaving all four tables empty = exactly the default behavior</span> — users who have not configured anything will never accidentally filter out or delete any resource.",
    "description": "Options header hint"
  },
  "options_sec_ext_title": {
    "message": "1. Extension rules (Ext)",
    "description": "Section ext title"
  },
  "options_sec_ext_hint": {
    "message": "Match exactly by resource extension. When matched, decide by \"operator + size\": keep if satisfied, drop otherwise.<br>Example: extension <code>mp4</code>, operator <code>&gt;=</code>, size <code>500</code> KB → mp4 files smaller than 500KB are never captured.",
    "description": "Section ext hint"
  },
  "options_th_enable": {
    "message": "Enabled",
    "description": "Table header enable"
  },
  "options_th_ext": {
    "message": "Extension (without dot)",
    "description": "Table header ext"
  },
  "options_th_operator": {
    "message": "Operator",
    "description": "Table header operator"
  },
  "options_th_size": {
    "message": "Size",
    "description": "Table header size"
  },
  "options_th_unit": {
    "message": "Unit",
    "description": "Table header unit"
  },
  "options_th_action": {
    "message": "Action",
    "description": "Table header action"
  },
  "options_btn_add_ext": {
    "message": "+ Add extension rule",
    "description": "Add ext rule button"
  },
  "options_sec_type_title": {
    "message": "2. MIME type rules (Type)",
    "description": "Section type title"
  },
  "options_sec_type_hint": {
    "message": "Match by response content-type; wildcards are supported (e.g. <code>video/*</code>, <code>audio/mpeg</code>).<br>The logic is the same as extension rules; MIME rules apply after extension rules.",
    "description": "Section type hint"
  },
  "options_th_mime": {
    "message": "MIME (supports *)",
    "description": "Table header mime"
  },
  "options_btn_add_type": {
    "message": "+ Add MIME rule",
    "description": "Add type rule button"
  },
  "options_sec_regex_title": {
    "message": "3. Custom regex (Regex)",
    "description": "Section regex title"
  },
  "options_sec_regex_hint": {
    "message": "Match against the full URL. If \"blacklist\" is checked, a match is dropped; if \"rewrite to\" is filled, the URL is rewritten with capture groups (e.g. <code>$$1</code>).<br>If the regex is invalid, that rule is skipped automatically without affecting other rules.",
    "description": "Section regex hint"
  },
  "options_th_regex": {
    "message": "Regular expression",
    "description": "Table header regex"
  },
  "options_th_flags": {
    "message": "Flags",
    "description": "Table header flags"
  },
  "options_th_black": {
    "message": "Blacklist (drop)",
    "description": "Table header blacklist"
  },
  "options_th_replace": {
    "message": "Rewrite to",
    "description": "Table header rewrite"
  },
  "options_btn_add_regex": {
    "message": "+ Add regex rule",
    "description": "Add regex rule button"
  },
  "options_input_testurl_ph": {
    "message": "Test URL, e.g. https://cdn.example.com/video.mp4?token=1",
    "description": "Test URL placeholder"
  },
  "options_btn_test": {
    "message": "Test the first enabled regex",
    "description": "Test regex button"
  },
  "options_sec_block_title": {
    "message": "4. URL allow/block list (blockUrl)",
    "description": "Section block title"
  },
  "options_sec_block_hint": {
    "message": "Match by \"the URL of the page that makes the request\"; wildcards <code>*</code> and <code>?</code> are supported. One per line.<br>Blocklist mode: matching sites are <b>not captured</b>; allowlist mode: <b>only</b> matching sites are captured.",
    "description": "Section block hint"
  },
  "options_block_black": {
    "message": "Blocklist (matching sites are not captured)",
    "description": "Blocklist radio"
  },
  "options_block_white": {
    "message": "Allowlist (only matching sites are captured)",
    "description": "Allowlist radio"
  },
  "options_block_hint2": {
    "message": "Note: <b>when the list is empty this rule does not apply (always allowed)</b> — so switching to allowlist mode before adding entries never results in \"capturing nothing\".",
    "description": "Blocklist empty hint"
  },
  "options_input_blocklist_ph": {
    "message": "One per line, e.g.:\n*://*.example.com/*\nhttps://www.bilibili.com/*",
    "description": "Blocklist textarea placeholder"
  },
  "options_sec_download_title": {
    "message": "5. Download settings",
    "description": "Section download title"
  },
  "options_sec_download_hint": {
    "message": "Control download behavior (stored locally, not synced to your account).",
    "description": "Section download hint"
  },
  "options_download_saveas_label": {
    "message": "Ask where to save on every download<br><span class=\"hint\">Default is <b>off</b>: save directly to the browser's default download folder (smoother for batch downloads). When on, you will be asked for a location on every download.</span>",
    "description": "Save-as checkbox label"
  },
  "options_label_filename_template": {
    "message": "Download filename template (empty = keep the original filename)",
    "description": "Filename template label"
  },
  "options_input_template_ph": {
    "message": "e.g. $${title}/$${fileName}.$${ext}",
    "description": "Filename template placeholder"
  },
  "options_template_hint": {
    "message": "Available variables: <code>$${title}</code> page title · <code>$${ext}</code> extension · <code>$${date}</code> date · <code>$${time}</code> time · <code>$${fileName}</code> original filename · <code>$${host}</code> domain · <code>$${type}</code> type<br>Subdirectories are supported (e.g. <code>$${title}/$${fileName}.$${ext}</code>; folders are created automatically).",
    "description": "Filename template hint"
  },
  "options_label_aria2": {
    "message": "aria2 RPC URL (empty = disable the \"Send to aria2\" button)",
    "description": "aria2 label"
  },
  "options_input_aria2_ph": {
    "message": "http://127.0.0.1:6800/jsonrpc",
    "description": "aria2 placeholder"
  },
  "options_aria2_hint": {
    "message": "If aria2 has a secret configured (<code>--rpc-secret</code>), use <code>http://127.0.0.1:6800/jsonrpc?token=your-secret</code>. The Referer and captured auth headers are passed through automatically when sending.",
    "description": "aria2 hint"
  },
  "options_btn_save": {
